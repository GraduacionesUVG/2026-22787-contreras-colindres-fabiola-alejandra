# ===========================================================
# QRisk - Backend (AWS Lambda, Node.js 20.x)
# Copia este archivo a .env y completa los valores.
# NUNCA subas el archivo .env real al repositorio.
# ===========================================================

# --- F2.1: Antigüedad de dominio (WhoisJSON) ---
# Plan gratuito: 1000 solicitudes/mes, 20/min
WHOIS_API_KEY=

# --- F2.2 y F2.3: Sandbox y vista previa (URLScan.io) ---
# Plan gratuito: 500 solicitudes/día, 50/h
URLSCAN_API_KEY=

# --- F2.2: Reputación y análisis (VirusTotal API v3) ---
# Plan gratuito: 500 solicitudes/día, 4/min
VT_API_KEY=

# --- Base de datos (Amazon RDS PostgreSQL) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- F2.3: Bucket privado de S3 para capturas ---
SCREENSHOTS_BUCKET=